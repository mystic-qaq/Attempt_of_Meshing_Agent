FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

castellatedMesh true;
snap            true;
addLayers       true;

geometry
{
    body.stl
    {
        type triSurfaceMesh;
        name body;
    }

    flow_far_wake
    {
        type searchableBox;
        min  (4.5 -0.63 -0.63);
        max  (10.5 0.63 0.63);
    }

    flow_aft_shear_core
    {
        type searchableBox;
        min  (1.5 -0.49 -0.49);
        max  (2.5 0.49 0.49);
    }

    repair_0
    {
        type searchableBox;
        min  (-1.579573582 -0.4419561654 -0.4419261965);
        max  (1.282487328 0.4419561965 0.4419261965);
    }

    flow_near_wake
    {
        type searchableBox;
        min  (1.5 -0.49 -0.49);
        max  (4.5 0.49 0.49);
    }
}


castellatedMeshControls
{

    maxLocalCells 2000000;
    maxGlobalCells 2000000;
    minRefinementCells 10;
    maxLoadUnbalance 0.10;
    nCellsBetweenLevels 3;

    resolveFeatureAngle 30;

    // Explicit feature edge refinement
    features
    (
        {
            file "body.eMesh";
            level 3;
        }
    );

    // Surface based refinement
    refinementSurfaces
    {
        body
        {
            level (3 3);
            patchInfo
            {
                type wall;
                inGroups (bodyGroup);
            }
        }
    }

    // Region-wise refinement
    refinementRegions
    {
        flow_far_wake
        {
            mode inside;
            levels
            (
                (1 2)
            );
        }
        flow_aft_shear_core
        {
            mode inside;
            levels
            (
                (1 4)
            );
        }
        repair_0
        {
            mode inside;
            levels
            (
                (1 4)
            );
        }
        flow_near_wake
        {
            mode inside;
            levels
            (
                (1 3)
            );
        }
        body
        {
            mode distance;
            levels
            (
                (0.09375 3)
                (0.28125 2)
            );
        }
    }

    locationInMesh (-3.079556897 -1.929556891 -1.929556891);
    allowFreeStandingZoneFaces false;
}


snapControls
{
    nSmoothPatch 5;
    tolerance 2;
    nSolveIter 80;
    nRelaxIter 8;
    nFeatureSnapIter 20;
    implicitFeatureSnap true;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;
}


addLayersControls
{
    relativeSizes false;

    layers
    {
        "(body).*"
        {
            nSurfaceLayers 7;
        }
    }

    expansionRatio 1.2;
    firstLayerThickness 0.001237896307;
    minThickness 0.0001237896307;
    nGrow 1;
    featureAngle 60;
    mergePatchFacesAngle 45;
    slipFeatureAngle 30;
    nRelaxIter 5;
    nSmoothSurfaceNormals 3;
    nSmoothNormals 8;
    nSmoothThickness 20;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.15;
    minMedialAxisAngle 60;
    nBufferCellsNoExtrude 0;
    nLayerIter 80;
    nOuterIter 2;
    meshShrinker displacementMedialAxis;
    additionalReporting true;
}

meshQualityControls
{
    #include "meshQualityDict"

    maxNonOrtho 65;
    maxBoundarySkewness 20;
    maxInternalSkewness 4;
    maxConcave 80;
    minVol 1e-13;
    minTetQuality 1e-15;
    minArea -1;
    minTwist 0.02;
    minDeterminant 0.001;
    minFaceWeight 0.05;
    minVolRatio 0.01;
    minTriangleTwist -1;
    nSmoothScale 4;
    errorReduction 0.75;
}

debugFlags ();

writeFlags
(
    scalarLevels
    layerSets
    layerFields
);

mergeTolerance 1e-06;

// ************************************************************************* //
