FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

castellatedMesh true;
snap            true;
addLayers       true;

geometry
{
    body.stl
    {
        type triSurfaceMesh;
        name body;
    }

    feature_0
    {
        type searchableBox;
        min  (0.787911674 -1.030732136 0.01794188198);
        max  (1.027337531 1.029921976 0.1259234827);
    }

    flow_lift_wake
    {
        type searchableBox;
        min  (0.9961947203 -1 -0.1896969102);
        max  (2.988584161 1 0.2470670402);
    }

    flow_tip_left
    {
        type searchableBox;
        min  (0.9961947203 -1.199238944 -0.2395066462);
        max  (2.988584161 -0.8007610559 0.2968767762);
    }

    flow_tip_right
    {
        type searchableBox;
        min  (0.9961947203 0.8007610559 -0.2395066462);
        max  (2.988584161 1.199238944 0.2968767762);
    }

    repair_0
    {
        type searchableBox;
        min  (0.7540901452 -0.7841605991 0.07952384651);
        max  (0.8384982198 -0.6905323714 0.1681832038);
    }

    repair_1
    {
        type searchableBox;
        min  (0.7540889531 0.6905324459 0.07947559096);
        max  (0.8384946734 0.7841607481 0.16808936);
    }
}


castellatedMeshControls
{

    maxLocalCells 2000000;
    maxGlobalCells 2000000;
    minRefinementCells 10;
    maxLoadUnbalance 0.10;
    nCellsBetweenLevels 3;

    resolveFeatureAngle 30;

    // Explicit feature edge refinement
    features
    (
        {
            file "body.eMesh";
            level 4;
        }
    );

    // Surface based refinement
    refinementSurfaces
    {
        body
        {
            level (4 4);
            patchInfo
            {
                type wall;
                inGroups (bodyGroup);
            }
        }
    }

    // Region-wise refinement
    refinementRegions
    {
        feature_0
        {
            mode inside;
            levels
            (
                (1 6)
            );
        }
        flow_lift_wake
        {
            mode inside;
            levels
            (
                (1 3)
            );
        }
        flow_tip_left
        {
            mode inside;
            levels
            (
                (1 3)
            );
        }
        flow_tip_right
        {
            mode inside;
            levels
            (
                (1 3)
            );
        }
        repair_0
        {
            mode inside;
            levels
            (
                (1 5)
            );
        }
        repair_1
        {
            mode inside;
            levels
            (
                (1 5)
            );
        }
        body
        {
            mode distance;
            levels
            (
                (0.03125 4)
                (0.09375 3)
            );
        }
    }

    locationInMesh (-1.119310263 -2.119310263 -1.159577965);
    allowFreeStandingZoneFaces false;
}


snapControls
{
    nSmoothPatch 3;
    tolerance 2;
    nSolveIter 70;
    nRelaxIter 9;
    nFeatureSnapIter 10;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;
}


addLayersControls
{
    relativeSizes false;

    layers
    {
        "(body).*"
        {
            nSurfaceLayers 8;
        }
    }

    expansionRatio 1.2;
    firstLayerThickness 0.001108680899;
    minThickness 0.0001108680899;
    nGrow 0;
    featureAngle 60;
    mergePatchFacesAngle 45;
    slipFeatureAngle 30;
    nRelaxIter 3;
    nSmoothSurfaceNormals 1;
    nSmoothNormals 3;
    nSmoothThickness 10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedialAxisAngle 90;
    nBufferCellsNoExtrude 0;
    nLayerIter 50;
    nOuterIter 1;
    meshShrinker displacementMedialAxis;
    additionalReporting true;
}

meshQualityControls
{
    #include "meshQualityDict"

    maxNonOrtho 65;
    maxBoundarySkewness 20;
    maxInternalSkewness 4;
    maxConcave 80;
    minVol 1e-13;
    minTetQuality 1e-15;
    minArea -1;
    minTwist 0.02;
    minDeterminant 0.001;
    minFaceWeight 0.05;
    minVolRatio 0.01;
    minTriangleTwist -1;
    nSmoothScale 4;
    errorReduction 0.75;
}

debugFlags ();

writeFlags
(
    scalarLevels
    layerSets
    layerFields
);

mergeTolerance 1e-06;

