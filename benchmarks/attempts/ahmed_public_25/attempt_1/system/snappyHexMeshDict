FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

castellatedMesh true;
snap            true;
addLayers       true;

geometry
{
    body.stl
    {
        type triSurfaceMesh;
        name body;
    }

    feature_0
    {
        type searchableBox;
        min  (0.05457041638 -0.2094318841 -0.0323551938);
        max  (0.149603952 -0.1163744278 0.07850685326);
    }

    feature_1
    {
        type searchableBox;
        min  (0.5250629903 0.1158884306 -0.02807062132);
        max  (0.6194153033 0.2090275099 0.07576026477);
    }

    feature_2
    {
        type searchableBox;
        min  (0.05518944574 0.1168659432 -0.03194378332);
        max  (0.1490022456 0.2107543027 0.06433198343);
    }

    feature_3
    {
        type searchableBox;
        min  (0.5244082489 -0.2100267941 -0.03022375598);
        max  (0.6106081652 -0.116161745 0.07461177833);
    }

    flow_near_wake
    {
        type searchableBox;
        min  (0.944 -0.2723 -0.0676);
        max  (1.988 0.2723 0.4056);
    }

    flow_far_wake
    {
        type searchableBox;
        min  (1.988 -0.3501 -0.1352);
        max  (4.076 0.3501 0.4732);
    }

    flow_base_shear
    {
        type searchableBox;
        min  (0.62 -0.2723 -0.0676);
        max  (0.944 0.2723 0.4056);
    }
}


castellatedMeshControls
{

    maxLocalCells 2000000;
    maxGlobalCells 2000000;
    minRefinementCells 10;
    maxLoadUnbalance 0.10;
    nCellsBetweenLevels 3;

    resolveFeatureAngle 30;

    // Explicit feature edge refinement
    features
    (
        {
            file "body.eMesh";
            level 3;
        }
    );

    // Surface based refinement
    refinementSurfaces
    {
        body
        {
            level (3 3);
            patchInfo
            {
                type wall;
                inGroups (bodyGroup);
            }
        }
    }

    // Region-wise refinement
    refinementRegions
    {
        feature_0
        {
            mode inside;
            levels
            (
                (1 5)
            );
        }
        feature_1
        {
            mode inside;
            levels
            (
                (1 5)
            );
        }
        feature_2
        {
            mode inside;
            levels
            (
                (1 5)
            );
        }
        feature_3
        {
            mode inside;
            levels
            (
                (1 5)
            );
        }
        flow_near_wake
        {
            mode inside;
            levels
            (
                (1 3)
            );
        }
        flow_far_wake
        {
            mode inside;
            levels
            (
                (1 2)
            );
        }
        flow_base_shear
        {
            mode inside;
            levels
            (
                (1 3)
            );
        }
        body
        {
            mode distance;
            levels
            (
                (0.032625 3)
                (0.097875 2)
            );
        }
    }

    locationInMesh (-0.6821299254 -0.7766299254 -0.5821299254);
    allowFreeStandingZoneFaces false;
}


snapControls
{
    nSmoothPatch 3;
    tolerance 2;
    nSolveIter 40;
    nRelaxIter 5;
    nFeatureSnapIter 10;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;
}


addLayersControls
{
    relativeSizes false;

    layers
    {
        "(body).*"
        {
            nSurfaceLayers 8;
        }
    }

    expansionRatio 1.2;
    firstLayerThickness 0.001113889709;
    minThickness 0.0001113889709;
    nGrow 0;
    featureAngle 60;
    mergePatchFacesAngle 45;
    slipFeatureAngle 30;
    nRelaxIter 3;
    nSmoothSurfaceNormals 1;
    nSmoothNormals 3;
    nSmoothThickness 10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedialAxisAngle 90;
    nBufferCellsNoExtrude 0;
    nLayerIter 50;
    nOuterIter 1;
    meshShrinker displacementMedialAxis;
    additionalReporting true;
}

meshQualityControls
{
    #include "meshQualityDict"

    maxNonOrtho 65;
    maxBoundarySkewness 20;
    maxInternalSkewness 4;
    maxConcave 80;
    minVol 1e-13;
    minTetQuality 1e-15;
    minArea -1;
    minTwist 0.02;
    minDeterminant 0.001;
    minFaceWeight 0.05;
    minVolRatio 0.01;
    minTriangleTwist -1;
    nSmoothScale 4;
    errorReduction 0.75;
}

debugFlags ();

writeFlags
(
    scalarLevels
    layerSets
    layerFields
);

mergeTolerance 1e-06;

